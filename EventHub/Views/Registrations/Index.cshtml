@model IEnumerable<EventHub.Models.Registration>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Registrations";
}

<div class="registrations-page">

    <!-- Page Header -->
    <section class="registrations-page-header">

        <div>

            <span class="section-label">
                EVENTHUB
            </span>

            <h1>My Registrations</h1>

            <p>
                View and manage your event registrations.
            </p>

        </div>


        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Create"
               class="btn btn-primary register-event-button">
                + Register for an Event
            </a>
        }

    </section>


    @if (!Model.Any())
    {
        <!-- Empty State -->
        <div class="registrations-empty-state">

            <div class="registration-empty-icon">
                🎟️
            </div>

            <h2>No Registrations Yet</h2>

            <p>
                You haven't registered for any events yet.
                Find an event and reserve your spot.
            </p>

            <a asp-controller="Events"
               asp-action="Index"
               class="btn btn-primary">
                Browse Events
            </a>

        </div>
    }
    else
    {
        <!-- Registration Count -->
        <div class="registrations-result-header">

            <p>
                You have
                <strong>@Model.Count()</strong>
                @(Model.Count() == 1 ? "registration" : "registrations")
            </p>

        </div>


        <!-- Registration Cards -->
        <div class="registrations-grid">

            @foreach (var registration in Model)
            {
                <article class="registration-card">

                    <!-- Card Header -->
                    <div class="registration-card-header">

                        <div class="registration-icon">
                            🎟️
                        </div>

                        <span class="registration-status">
                            Registered
                        </span>

                    </div>


                    <!-- Card Content -->
                    <div class="registration-card-content">

                        <h2>
                            @registration.Event?.Title
                        </h2>


                        <div class="registration-information">

                            <div class="registration-info-item">

                                <span class="registration-info-icon">
                                    📅
                                </span>

                                <div>
                                    <small>Event Date</small>

                                    <strong>
                                        @registration.Event?.EventDate.ToString("MMM dd, yyyy")
                                    </strong>
                                </div>

                            </div>


                            <div class="registration-info-item">

                                <span class="registration-info-icon">
                                    📍
                                </span>

                                <div>
                                    <small>Location</small>

                                    <strong>
                                        @registration.Event?.Location
                                    </strong>
                                </div>

                            </div>


                            <div class="registration-info-item">

                                <span class="registration-info-icon">
                                    📝
                                </span>

                                <div>
                                    <small>Registered On</small>

                                    <strong>
                                        @registration.RegistrationDate.ToString("MMM dd, yyyy")
                                    </strong>
                                </div>

                            </div>

                        </div>


                        <!-- Actions -->
                        <div class="registration-actions">

                            <a asp-action="Details"
                               asp-route-id="@registration.RegistrationId"
                               class="registration-action-primary">
                                View Details
                                <span>→</span>
                            </a>


                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@registration.RegistrationId"
                                   class="registration-action-secondary">
                                    Edit
                                </a>
                            }


                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@registration.RegistrationId"
                                   class="registration-action-delete">
                                    Delete
                                </a>
                            }

                        </div>

                    </div>

                </article>
            }

        </div>
    }

</div>