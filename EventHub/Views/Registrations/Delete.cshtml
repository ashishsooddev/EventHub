@model EventHub.Models.Registration

@{
    ViewData["Title"] = "Delete Registration";
}

<div class="delete-page">

    <div class="delete-header">

        <div class="delete-icon">
            !
        </div>

        <span class="section-label">
            EVENTHUB
        </span>

        <h1>Cancel Registration</h1>

        <p>
            Are you sure you want to delete this registration?
            This action cannot be undone.
        </p>

    </div>


    <div class="delete-card">

        <div class="delete-event-information">

            <span class="details-label">
                REGISTRATION TO BE DELETED
            </span>

            <h2>
                @Model.Event?.Title
            </h2>


            <div class="registration-delete-details">

                <div class="registration-delete-item">

                    <span>📅</span>

                    <div>
                        <small>Event Date</small>

                        <strong>
                            @Model.Event?.EventDate.ToString("MMMM dd, yyyy h:mm tt")
                        </strong>
                    </div>

                </div>


                <div class="registration-delete-item">

                    <span>📍</span>

                    <div>
                        <small>Location</small>

                        <strong>
                            @Model.Event?.Location
                        </strong>
                    </div>

                </div>


                <div class="registration-delete-item">

                    <span>📝</span>

                    <div>
                        <small>Registration Date</small>

                        <strong>
                            @Model.RegistrationDate.ToString("MMMM dd, yyyy")
                        </strong>
                    </div>

                </div>

            </div>

        </div>


        <div class="delete-warning">

            <strong>Warning</strong>

            <p>
                Deleting this registration will remove your
                registration for this event.
            </p>

        </div>


        <form asp-action="Delete"
              method="post"
              class="delete-form">

            <input type="hidden"
                   asp-for="RegistrationId" />

            <button type="submit"
                    class="delete-confirm-button">
                Delete Registration
            </button>

            <a asp-action="Index"
               class="delete-cancel-button">
                Cancel
            </a>

        </form>

    </div>

</div>