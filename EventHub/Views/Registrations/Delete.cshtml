@model EventHub.Models.Registration

@{
    ViewData["Title"] = "Delete Registration";
}

<div class="delete-page">

    <h1>Delete Registration</h1>

    <p>
        Are you sure you want to delete this registration?
    </p>

    <div class="registration-information">

        <h2>@Model.Event?.Title</h2>

        <p>
            <strong>Event Date:</strong>
            @Model.Event?.EventDate.ToString("MMMM dd, yyyy h:mm tt")
        </p>

        <p>
            <strong>Location:</strong>
            @Model.Event?.Location
        </p>

        <p>
            <strong>Registration Date:</strong>
            @Model.RegistrationDate.ToString("MMMM dd, yyyy")
        </p>

    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden"
               asp-for="RegistrationId" />

        <button type="submit">
            Delete Registration
        </button>

        <a asp-action="Index">
            Cancel
        </a>

    </form>

</div>