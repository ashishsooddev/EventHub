@model EventHub.Models.Registration

@{
    ViewData["Title"] = "Edit Registration";
}

<div class="registration-form-page">

    <div class="registration-form-header">

        <span class="section-label">EVENTHUB</span>

        <h1>Edit Registration</h1>

        <p>
            Change the event associated with your registration.
        </p>

    </div>


    <div class="registration-form-card">

        <form asp-action="Edit" method="post">

            <input type="hidden"
                   asp-for="RegistrationId" />


            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <div class="form-group">

                <label asp-for="EventId">
                    Event
                </label>

                <select asp-for="EventId"
                        asp-items="ViewBag.EventId"
                        class="form-control">

                    <option value="">
                        Select an event
                    </option>

                </select>

                <span asp-validation-for="EventId"
                      class="validation-message">
                </span>

            </div>


            <div class="form-buttons">

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-action="Index"
                   class="btn form-cancel-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}