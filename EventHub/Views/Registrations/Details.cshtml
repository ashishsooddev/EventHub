@model EventHub.Models.Registration

@{
    ViewData["Title"] = "Registration Details";
}

<div class="registration-details-page">

    <!-- Header -->
    <div class="registration-details-header">

        <div class="registration-details-icon">
            🎟️
        </div>

        <div>
            <span class="section-label">EVENTHUB REGISTRATION</span>

            <h1>Registration Details</h1>

            <p>
                Your event registration information.
            </p>
        </div>

    </div>


    <!-- Details Card -->
    <div class="registration-details-card">

        <span class="details-label">
            REGISTERED EVENT
        </span>

        <h2>@Model.Event?.Title</h2>


        <div class="registration-details-information">

            <div class="registration-detail-item">

                <span class="registration-detail-icon">
                    📅
                </span>

                <div>
                    <small>Event Date</small>

                    <strong>
                        @Model.Event?.EventDate.ToString("MMMM dd, yyyy h:mm tt")
                    </strong>
                </div>

            </div>


            <div class="registration-detail-item">

                <span class="registration-detail-icon">
                    📍
                </span>

                <div>
                    <small>Location</small>

                    <strong>
                        @Model.Event?.Location
                    </strong>
                </div>

            </div>


            <div class="registration-detail-item">

                <span class="registration-detail-icon">
                    📝
                </span>

                <div>
                    <small>Registration Date</small>

                    <strong>
                        @Model.RegistrationDate.ToString("MMMM dd, yyyy")
                    </strong>
                </div>

            </div>

        </div>


        <!-- Actions -->
        <div class="registration-details-actions">

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.RegistrationId"
                   class="registration-details-edit">
                    Edit Registration
                </a>
            }

            <a asp-action="Index"
               class="registration-details-back">
                ← Back to Registrations
            </a>

        </div>

    </div>

</div>