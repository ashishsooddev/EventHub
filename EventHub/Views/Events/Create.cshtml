@model EventHub.Models.Event

@{
    ViewData["Title"] = "Create Event";
}

<div class="event-form-page">

    <!-- Page Header -->
    <div class="event-form-header">

        <span class="section-label">EVENTHUB</span>

        <h1>Create an Event</h1>

        <p>
            Share your event with the EventHub community.
        </p>

    </div>


    <!-- Form Card -->
    <div class="event-form-card">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>


            <!-- Event Title -->
            <div class="form-group">

                <label asp-for="Title">
                    Event Title
                </label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="Enter the event title" />

                <span asp-validation-for="Title"
                      class="validation-message">
                </span>

            </div>


            <!-- Description -->
            <div class="form-group">

                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control event-description-input"
                          placeholder="Tell people about your event..."></textarea>

                <span asp-validation-for="Description"
                      class="validation-message">
                </span>

            </div>


            <!-- Date and Capacity -->
            <div class="form-row">

                <div class="form-group">

                    <label asp-for="EventDate">
                        Date & Time
                    </label>

                    <input asp-for="EventDate"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="EventDate"
                          class="validation-message">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Capacity">
                        Capacity
                    </label>

                    <input asp-for="Capacity"
                           type="number"
                           class="form-control"
                           placeholder="Number of people" />

                    <span asp-validation-for="Capacity"
                          class="validation-message">
                    </span>

                </div>

            </div>


            <!-- Location -->
            <div class="form-group">

                <label asp-for="Location">
                    Location
                </label>

                <input asp-for="Location"
                       class="form-control"
                       placeholder="Enter event location" />

                <span asp-validation-for="Location"
                      class="validation-message">
                </span>

            </div>


            <!-- Categories -->
            <div class="form-group">

                <label>
                    Categories
                </label>

                <p class="form-help-text">
                    Select one or more categories for your event.
                </p>

                <select name="CategoryIds"
                        multiple
                        asp-items="ViewBag.Categories"
                        class="form-control category-select">
                </select>

            </div>


            <!-- Form Buttons -->
            <div class="form-buttons">

                <button type="submit"
                        class="btn btn-primary">
                    Create Event
                </button>

                <a asp-action="Index"
                   class="btn form-cancel-button">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>


@* It is used to reduce the reloading time and get the result better *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}