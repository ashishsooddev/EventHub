@model EventHub.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="event-form">

    <h1>Edit Event</h1>

    <form asp-action="Edit" method="post">
        <input type="hidden"asp-for="EventId" />

        <div asp-validation-summary="ModelOnly"
             class="validation-message">
        </div>

        <div class="form-group">
            <label asp-for="Title"></label>
            <input asp-for="Title" />
            <span asp-validation-for="Title"
                  class="validation-message">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description"></textarea>
            <span asp-validation-for="Description"
                  class="validation-message">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="EventDate"></label>
            <input asp-for="EventDate"
                   type="datetime-local" />
            <span asp-validation-for="EventDate"
                  class="validation-message">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Location"></label>
            <input asp-for="Location" />
            <span asp-validation-for="Location"
                  class="validation-message">
            </span>
        </div>

        <div class="form-group">
            <label asp-for="Capacity"></label>
            <input asp-for="Capacity"
                   type="number" />
            <span asp-validation-for="Capacity"
                  class="validation-message">
            </span>
        </div>

        <div class="form-group">
            <label>Categories</label>
            <select name="CategoryIds"
                    multiple
                    asp-items="ViewBag.Categories">
            </select>
        </div>

        <div class="form-buttons">
            <button type="submit">Save Changes</button>
            <a asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

