@model EventHub.Models.DashboardViewModel

@{
    ViewData["Title"] = "EventHub";
}

<div class="home-page">

    <!-- Hero Section -->
    <section class="home-hero">

        <div class="hero-content">
            <span class="hero-label">WELCOME TO EVENTHUB</span>

            <h1>Discover Events.<br />Create Memories.</h1>

            <p>
                Discover exciting events, explore new experiences,
                and stay connected with what's happening around you.
            </p>

            <div class="hero-buttons">
                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-primary">
                    Explore Events
                </a>

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Events"
                       asp-action="Create"
                       class="btn hero-secondary-button">
                        Create Event
                    </a>
                }
            </div>
        </div>

        <div class="hero-decoration">
            <div class="hero-calendar">
                <div class="calendar-top">
                    <span>EVENT</span>
                    <span>HUB</span>
                </div>

                <div class="calendar-content">
                    <div class="calendar-number">2026</div>
                    <div class="calendar-text">Discover what's happening.</div>
                </div>
            </div>
        </div>

    </section>


    <!-- Dashboard Statistics -->
    <section class="dashboard-section">

        <div class="section-heading">
            <span class="section-label">EVENTHUB AT A GLANCE</span>
            <h2>Explore Our Community</h2>
        </div>

        <div class="dashboard-cards">

            <div class="dashboard-card">
                <div class="dashboard-icon">
                    📅
                </div>

                <div>
                    <h2>@Model.TotalEvents</h2>
                    <p>Total Events</p>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="dashboard-icon">
                    🏷️
                </div>

                <div>
                    <h2>@Model.TotalCategories</h2>
                    <p>Total Categories</p>
                </div>
            </div>

            <div class="dashboard-card">
                <div class="dashboard-icon">
                    👥
                </div>

                <div>
                    <h2>@Model.TotalRegistrations</h2>
                    <p>Total Registrations</p>
                </div>
            </div>

        </div>

    </section>


    <!-- Upcoming Events -->
    <section class="upcoming-events">

        <div class="section-heading events-heading">

            <div>
                <span class="section-label">DON'T MISS OUT</span>
                <h2>Upcoming Events</h2>
            </div>

            <a asp-controller="Events"
               asp-action="Index"
               class="view-all-link">
                View All Events →
            </a>

        </div>


        @if (Model.UpcomingEvents.Any())
        {
            <div class="event-grid">

                @foreach (var eventItem in Model.UpcomingEvents)
                {
                    <div class="event-card">

                        <div class="event-card-header">
                            <span class="event-badge">
                                Upcoming
                            </span>
                        </div>

                        <div class="event-card-body">

                            <h3>@eventItem.Title</h3>

                            <div class="event-info">
                                <p>
                                    <span class="event-info-icon">📅</span>
                                    @eventItem.EventDate.ToString("MMM dd, yyyy")
                                </p>

                                <p>
                                    <span class="event-info-icon">🕒</span>
                                    @eventItem.EventDate.ToString("h:mm tt")
                                </p>

                                <p>
                                    <span class="event-info-icon">📍</span>
                                    @eventItem.Location
                                </p>
                            </div>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.EventId"
                               class="event-details-button">
                                View Details
                                <span>→</span>
                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="empty-events">
                <div class="empty-events-icon">
                    📅
                </div>

                <h3>No Upcoming Events</h3>

                <p>
                    There are currently no upcoming events.
                    Check back soon for new events.
                </p>
            </div>
        }

    </section>

</div>