@model EventHub.Models.DashboardViewModel

@{
    ViewData["Title"] = "EventHub";
}

<div class="home-page">

    <h1>Welcome to EventHub</h1>

    <p>Discover and manage upcoming events.</p>

    <div class="dashboard-cards">

        <div class="dashboard-card">
            <h2>@Model.TotalEvents</h2>
            <p>Total Events</p>
        </div>

        <div class="dashboard-card">
            <h2>@Model.TotalCategories</h2>
            <p>Total Categories</p>
        </div>

        <div class="dashboard-card">
            <h2>@Model.TotalRegistrations</h2>
            <p>Total Registrations</p>
        </div>

    </div>

    <div class="upcoming-events">

        <h2>Upcoming Events</h2>

        @if (Model.UpcomingEvents.Any())
        {
            @foreach (var eventItem in Model.UpcomingEvents)
            {
                <div class="event-card">

                    <h3>@eventItem.Title</h3>

                    <p>
                        @eventItem.EventDate.ToString("MMM dd, yyyy h:mm tt")
                    </p>

                    <p>@eventItem.Location</p>

                    <a asp-controller="Events"
                       asp-action="Details"
                       asp-route-id="@eventItem.EventId">
                        View Details
                    </a>

                </div>
            }
        }
        else
        {
            <p>No upcoming events.</p>
        }

    </div>

</div>