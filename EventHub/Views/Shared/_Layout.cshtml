<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EventHub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventHub.styles.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm eventhub-navbar">
            <div class="container">

                <a class="navbar-brand eventhub-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">E</span>
                    <span>EventHub</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav eventhub-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Events"
                               asp-action="Index">
                                Events
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Categories"
                               asp-action="Index">
                                Categories
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Registrations"
                                   asp-action="Index">
                                    My Registrations
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="eventhub-footer">
        <div class="container">

            <div class="footer-content">

                <div>
                    <div class="footer-brand">EventHub</div>
                    <p>
                        Discover events and create memorable experiences.
                    </p>
                </div>

                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Events" asp-action="Index">Events</a>
                    <a asp-controller="Categories" asp-action="Index">Categories</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>

            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 EventHub</span>
                <span>All rights reserved.</span>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>