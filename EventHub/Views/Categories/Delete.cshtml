@model EventHub.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="delete-page">

    <!-- Delete Header -->
    <div class="delete-header">

        <div class="delete-icon">
            !
        </div>

        <span class="section-label">
            EVENTHUB
        </span>

        <h1>Delete Category</h1>

        <p>
            Are you sure you want to delete this category?
            This action cannot be undone.
        </p>

    </div>


    <!-- Category Information -->
    <div class="delete-card">

        <div class="delete-event-information">

            <span class="details-label">
                CATEGORY TO BE DELETED
            </span>

            <h2>@Model.Name</h2>


            <div class="category-delete-description">

                <small>Description</small>

                <p>
                    @Model.Description
                </p>

            </div>


            <div class="category-delete-event-count">

                <span class="delete-detail-icon">
                    📅
                </span>

                <div>

                    <small>Events in this category</small>

                    <strong>
                        @Model.Events.Count
                    </strong>

                </div>

            </div>

        </div>


        <!-- Warning -->
        <div class="delete-warning">

            <strong>Warning</strong>

            <p>
                Deleting this category may affect events assigned
                to it. Please make sure you want to continue.
            </p>

        </div>


        <!-- Buttons -->
        <form asp-action="Delete"
              method="post"
              class="delete-form">

            <input type="hidden"
                   asp-for="CategoryId" />

            <button type="submit"
                    class="delete-confirm-button">
                Delete Category
            </button>

            <a asp-action="Index"
               class="delete-cancel-button">
                Cancel
            </a>

        </form>

    </div>

</div>